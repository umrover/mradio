[submodule "fw/stm32h7/STM32CubeH7"]
	path = fw/stm32h7/STM32CubeH7
	url = https://github.com/STMicroelectronics/STM32CubeH7.git
[submodule "demo/mm-iot-sdk"]
	path = demo/mm-iot-sdk
	url = git@github.com:MorseMicro/mm-iot-sdk.git
[submodule "demo_f4/drivers/stm32f4xx-hal-driver"]
	path = demo_f4/drivers/stm32f4xx-hal-driver
	url = https://github.com/STMicroelectronics/stm32f4xx-hal-driver
[submodule "demo_f4/drivers/cmsis-device-f4"]
	path = demo_f4/drivers/cmsis-device-f4
	url = https://github.com/STMicroelectronics/cmsis-device-f4
